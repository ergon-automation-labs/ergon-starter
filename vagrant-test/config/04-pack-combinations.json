{
  "_comment": [
    "Phase 4 — pack combination matrix. Pack names are REAL keys from",
    "catalog/packs.json (the 'Primary/Learning/Social' names in the first",
    "draft matched nothing and every combo would have generated the same",
    "12-bot compose). Expected bot sets are NOT stored here: the matrix",
    "computes them as union(packs) ∩ catalog names and verifies via the",
    "live NATS registry (bot_army.registry.bots.list) — empirical, and",
    "immune to hand-maintained-list rot (P11 lessons).",
    "Static subject lists were dropped for the same reason; the registry",
    "plus a system.health request plus per-container health is the gate."
  ],
  "combos": {
    "Core": {
      "description": "Baseline: the core pack alone (12 bots)",
      "packs": ["core"],
      "tier": "core",
      "timeout_seconds": 60
    },
    "Core-LearningDeepdive": {
      "description": "Core + knowledge deep-dive (terrain, internal_docs)",
      "packs": ["core", "learning_deepdive"],
      "tier": "core",
      "timeout_seconds": 75
    },
    "Core-SocialMedia": {
      "description": "Core + media pipeline (youtube_manager, media_ingestion)",
      "packs": ["core", "social_media"],
      "tier": "core",
      "timeout_seconds": 75
    },
    "Core-Research": {
      "description": "Core + research feeds (feeds, rss_polling)",
      "packs": ["core", "research"],
      "tier": "core",
      "timeout_seconds": 75
    },
    "Core-Areas": {
      "description": "Core + areas (fitness, chore, rpg)",
      "packs": ["core", "areas"],
      "tier": "extended",
      "timeout_seconds": 75
    },
    "Core-Full": {
      "description": "Everything: core + all add-on packs",
      "packs": ["core", "learning_deepdive", "social_media", "areas", "research"],
      "tier": "extended",
      "timeout_seconds": 90
    }
  }
}