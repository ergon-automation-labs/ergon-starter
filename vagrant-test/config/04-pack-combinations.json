{
  "combos": {
    "Primary": {
      "description": "Baseline: Task management + Bridge",
      "packs": ["Primary"],
      "bots": ["gtd_bot", "claude_bridge", "llm_proxy", "dispatcher"],
      "subjects": [
        "bridge.task.list",
        "bridge.internal_docs.query",
        "system.health.bridge",
        "llm.request.converse"
      ],
      "tier": "core",
      "timeout_seconds": 60
    },
    "Primary+Learning": {
      "description": "Task management + Knowledge (GTD + Terrain + Docs)",
      "packs": ["Primary", "Learning"],
      "bots": [
        "gtd_bot", "claude_bridge", "llm_proxy", "dispatcher",
        "terrain_bot", "internal_docs_bot", "graphify_cache_bot"
      ],
      "subjects": [
        "bridge.task.list",
        "terrain.lesson.generate",
        "internal_docs.query",
        "bot_army.graph.query",
        "llm.request.converse"
      ],
      "tier": "core",
      "timeout_seconds": 90
    },
    "Primary+Social": {
      "description": "Task management + Chat (GTD + Synapse + Discord)",
      "packs": ["Primary", "Social"],
      "bots": [
        "gtd_bot", "claude_bridge", "llm_proxy", "dispatcher",
        "synapse_bot", "notification_router_bot", "discord_integration_bot"
      ],
      "subjects": [
        "bridge.task.list",
        "bridge.chat",
        "synapse.command.dispatch",
        "notification_router.publish",
        "llm.request.converse"
      ],
      "tier": "core",
      "timeout_seconds": 90
    },
    "Primary+Learning+Social": {
      "description": "Full featured: Tasks + Knowledge + Chat",
      "packs": ["Primary", "Learning", "Social"],
      "bots": [
        "gtd_bot", "claude_bridge", "llm_proxy", "dispatcher",
        "terrain_bot", "internal_docs_bot", "graphify_cache_bot",
        "synapse_bot", "notification_router_bot", "discord_integration_bot"
      ],
      "subjects": [
        "bridge.task.list",
        "bridge.chat",
        "terrain.lesson.generate",
        "internal_docs.query",
        "bot_army.graph.query",
        "synapse.command.dispatch",
        "llm.request.converse"
      ],
      "tier": "core",
      "timeout_seconds": 120
    },
    "Primary+Background": {
      "description": "Foreground + Background (GTD + async LLM/feeds)",
      "packs": ["Primary", "Background"],
      "bots": [
        "gtd_bot", "claude_bridge", "llm_proxy", "dispatcher",
        "job_applications_bot", "rss_polling_bot"
      ],
      "subjects": [
        "bridge.task.list",
        "llm.request.converse",
        "job_applications.query",
        "rss_polling.refresh"
      ],
      "tier": "extended",
      "timeout_seconds": 90
    },
    "Learning+Research": {
      "description": "Knowledge + Content (Terrain + Feeds + Jobs)",
      "packs": ["Learning", "Research"],
      "bots": [
        "terrain_bot", "internal_docs_bot", "graphify_cache_bot",
        "rss_polling_bot", "job_applications_bot", "media_ingestion_bot",
        "llm_proxy"
      ],
      "subjects": [
        "terrain.lesson.generate",
        "internal_docs.query",
        "bot_army.graph.query",
        "rss_polling.refresh",
        "job_applications.query",
        "media_ingestion.ingest"
      ],
      "tier": "extended",
      "timeout_seconds": 90
    },
    "Primary+Learning+Social+Background": {
      "description": "Everything (maximum fleet)",
      "packs": ["Primary", "Learning", "Social", "Background"],
      "bots": [
        "gtd_bot", "claude_bridge", "llm_proxy", "dispatcher",
        "terrain_bot", "internal_docs_bot", "graphify_cache_bot",
        "synapse_bot", "notification_router_bot", "discord_integration_bot",
        "job_applications_bot", "rss_polling_bot"
      ],
      "subjects": [
        "bridge.task.list",
        "bridge.chat",
        "terrain.lesson.generate",
        "internal_docs.query",
        "bot_army.graph.query",
        "synapse.command.dispatch",
        "job_applications.query",
        "rss_polling.refresh",
        "llm.request.converse"
      ],
      "tier": "extended",
      "timeout_seconds": 150
    }
  },
  "tiers": {
    "core": "Must pass: Primary alone, + Learning, + Social, all three together",
    "extended": "Nice to have: Background combos, Research combos, maximum fleet"
  },
  "notes": {
    "strategy": "Start with core tier (realistic user flows). Extended tier tests edge cases and max capacity.",
    "nats_port": "54222 (forwarded from vagrant VM)",
    "database": "Single PostgreSQL handles all packs' schemas",
    "docker_compose": "Generated by quickstart-default.sh based on selected packs"
  }
}
