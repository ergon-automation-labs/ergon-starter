# Build the bot-army CLI tool inside Docker (Go not required on host).
FROM golang:1.25-alpine AS build

RUN apk add --no-cache git

WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download

COPY . .
RUN CGO_ENABLED=0 go build -o /bot-army ./cmd/bot-army

FROM alpine:3.20
RUN apk add --no-cache git wget tar docker-cli docker-compose
RUN git config --global url."https://github.com/".insteadOf "git@github.com:" && \
    git config --global --add url."https://github.com/".insteadOf "ssh://git@github.com/"
COPY --from=build /bot-army /usr/local/bin/bot-army
